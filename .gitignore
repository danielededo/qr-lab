# Generic ignores: OS, editors/IDEs, secrets, logs, temp files.
# Language/build-specific ignores (node_modules/, target/, __pycache__/, ...)
# belong to each project — add them when you pick the stack.

### Operating systems
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~
.directory
.Trash-*

### Editors / IDEs
# JetBrains
.idea/
*.iml
# Visual Studio Code (keep shared settings if you deliberately commit them)
.vscode/*
!.vscode/extensions.json
# Vim
*.swp
*.swo
# Emacs
\#*\#
.\#*

### Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.*

### Logs and temporary files
*.log
logs/
tmp/
.tmp/
*.bak
*.orig

### Python (this project's stack)
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/

### Generated QR images (examples live in docs, outputs stay local)
/wifi-qr/*.png
/wifi-qr/*.svg
/totp-qr/*.png
/totp-qr/*.svg
